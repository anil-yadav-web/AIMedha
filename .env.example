# Local CPU embeddings. No paid API, GPU, or Docker required.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.63
TOP_K=5
QUERY_CACHE_SIZE=256
# Optional: provider=http uses a compatible embeddings endpoint.
EMBEDDING_API_URL=
API_KEY=
# Collection writes are disabled unless this is set. Never send it to the browser.
ADMIN_TOKEN=
# Same-origin production deployment needs no CORS exceptions.
CORS_ORIGINS=[]
# Optional overrides: MODEL_CACHE, INDEX_DIR, NOTICES_PATH, FRONTEND_DIST
